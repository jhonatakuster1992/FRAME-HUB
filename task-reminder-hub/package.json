{
  "name": "task-reminder-hub",
  "version": "0.1.0",
  "description": "Hub de tarefas, lembretes e agenda com post-it flutuante e briefing de not\u00edcias em voz",
  "main": "./out/main/index.js",
  "author": "Jhonata Kuster",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --import ./tests/register-alias.mjs --test \"tests/**/*.test.ts\"",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "node-schedule": "^2.1.1",
    "rss-parser": "^3.13.0",
    "say": "^0.16.0"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "@types/node-schedule": "^2.1.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
